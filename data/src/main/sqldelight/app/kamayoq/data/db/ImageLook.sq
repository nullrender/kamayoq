-- The image reader's general settings: one row at most (core ImageModeSettings).
CREATE TABLE image_look_general (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    -- ImageModeChoice wire name from core; null is Automatic, what the work's metadata says.
    mode TEXT,
    -- The hint on the first opening in Pages right to left shows once in the app (1 after "Got it").
    right_to_left_hint_seen INTEGER NOT NULL DEFAULT 0 CHECK (right_to_left_hint_seen IN (0, 1))
);

-- What one work chose apart from the general setting. A null mode, or no row, follows the general one.
CREATE TABLE work_image_look (
    work_id TEXT NOT NULL PRIMARY KEY REFERENCES work(id),
    -- ImageModeChoice wire name from core; Automatic here is kept as chosen, apart from following.
    mode TEXT
);

general:
SELECT mode, right_to_left_hint_seen FROM image_look_general WHERE id = 1;

ensureGeneral:
INSERT OR IGNORE INTO image_look_general (id) VALUES (1);

saveGeneral:
UPDATE image_look_general SET mode = ? WHERE id = 1;

markRightToLeftHintSeen:
UPDATE image_look_general SET right_to_left_hint_seen = 1 WHERE id = 1;

ofWork:
SELECT mode FROM work_image_look WHERE work_id = ?;

ensureWork:
INSERT OR IGNORE INTO work_image_look (work_id) VALUES (?);

saveWork:
UPDATE work_image_look SET mode = ? WHERE work_id = ?;
